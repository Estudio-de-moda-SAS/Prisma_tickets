{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/favicon.*",
      "/icons.svg",
      "/manifest.json",
      "/version.json",
      "/sw.js",
      "/registerSW.js",
      "/workbox-*.js",
      "/*.png"
    ]
  },
  "routes": [
    { "route": "/sw.js",         "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/version.json",  "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" } },
    { "route": "/manifest.json", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}