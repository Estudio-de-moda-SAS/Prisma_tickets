      "lineRange": [
        121,
        126
      ],
      "summary": "Envuelve una promesa de notificación con un `catch` que loguea errores y, si existe `EdgeRuntime.waitUntil`, la registra para que corra en segundo plano tras enviar la respuesta.",
      "tags": [
        "background-task",
        "notificaciones",
        "edge-runtime"
      ],
      "complexity": "simple"
    },
    {
      "id": "file:supabase/functions/api/handlers/requests.ts",
